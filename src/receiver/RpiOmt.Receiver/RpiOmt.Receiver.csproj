<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RpiOmt.Receiver</RootNamespace>
    <AssemblyName>omt-receiver</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Most source in this assembly is an unmodified upstream interop layer.
         It is validated by compile/runtime tests instead of first-party API
         style analyzers. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RpiOmt.Receiver.Core/RpiOmt.Receiver.Core.csproj" />
    <ProjectReference Include="../../../third_party/omt/libomtnet/libomtnet.csproj" />
    <Compile Include="../../../third_party/omt/omtplayer/audio/ALSAPlayer.cs"
             Link="Audio/ALSAPlayer.cs" />
    <Compile Include="../../../third_party/omt/omtplayer/drm/*.cs"
             Link="Drm/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
