<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens shared by every view. Both theme variants are defined so the
       window follows the operating system when the theme selector is on System. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#F2F6FB" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#DBE3EE" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#101A2B" />
      <SolidColorBrush x:Key="AppMutedBrush" Color="#4B5B72" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#0B5CAB" />
      <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E3EDF9" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="#B3261E" />
      <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FDECEA" />
      <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#F7F9FC" />
      <SolidColorBrush x:Key="LogInfoBrush" Color="#1C2A3D" />
      <SolidColorBrush x:Key="LogWarningBrush" Color="#8A5200" />
      <SolidColorBrush x:Key="LogErrorBrush" Color="#B3261E" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#131D2C" />
      <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1B2942" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#26344A" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#EAF1FA" />
      <SolidColorBrush x:Key="AppMutedBrush" Color="#A8B8CD" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#7CB8FF" />
      <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1D3B5E" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="#FF9090" />
      <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#33161C" />
      <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#060C15" />
      <SolidColorBrush x:Key="LogInfoBrush" Color="#DCE6F2" />
      <SolidColorBrush x:Key="LogWarningBrush" Color="#F2C26B" />
      <SolidColorBrush x:Key="LogErrorBrush" Color="#FF9090" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="AppCornerRadiusSmall">4</CornerRadius>
  <Thickness x:Key="AppPanelPadding">14</Thickness>
  <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>
</ResourceDictionary>
