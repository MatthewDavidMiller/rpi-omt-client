<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RpiOmt.Deployer.App.ViewModels"
        x:Class="RpiOmt.Deployer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Raspberry Pi OMT Client Deployer"
        Width="1000" Height="780" MinWidth="520" MinHeight="520"
        Background="{DynamicResource AppSurfaceAltBrush}"
        Closing="OnClosing">
  <Grid Margin="14" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="100" />
      <RowDefinition Height="6" />
      <RowDefinition Height="3*" MinHeight="80" />
      <RowDefinition Height="6" />
      <RowDefinition Height="5*" MinHeight="120" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Text="Raspberry Pi OMT Client Deployer" Classes="title" />
        <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat='Version {0}'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Theme" Classes="field-label" />
        <ComboBox x:Name="ThemeSelector" MinWidth="110"
                  ItemsSource="{Binding ThemeOptions}"
                  SelectedItem="{Binding Theme}"
                  AutomationProperties.Name="Theme" />
      </StackPanel>
    </Grid>

    <!-- The two connection columns stack when the window is too narrow to hold
         them side by side. Both groups span the full width once stacked. -->
    <Panel Grid.Row="1" Container.Name="connection" Container.Sizing="Width">
      <Panel.Styles>
        <ContainerQuery Name="connection" Query="max-width:760">
          <Style Selector="StackPanel.connection-column-a">
            <Setter Property="Grid.ColumnSpan" Value="2" />
          </Style>
          <Style Selector="StackPanel.connection-column-b">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
          </Style>
        </ContainerQuery>
      </Panel.Styles>
      <Border Classes="panel" IsEnabled="{Binding InputsEnabled}">
        <ScrollViewer>
          <Grid x:Name="ConnectionGrid" RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="10">
            <TextBlock Grid.ColumnSpan="2" Text="Connection" Classes="section-title" />

            <StackPanel Grid.Row="1" Grid.Column="0" Classes="connection-column-a" Spacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Pi host" Classes="field-label" />
                <TextBox x:Name="HostTextBox" Text="{Binding Host}"
                         PlaceholderText="pi.local or 192.168.1.10" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Text="Username" Classes="field-label" />
                  <TextBox Text="{Binding Username}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" Width="96">
                  <TextBlock Text="SSH port" Classes="field-label" />
                  <TextBox MinWidth="0" Text="{Binding Port}" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Classes="connection-column-b" Spacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Authentication" Classes="field-label" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton Content="Password" GroupName="authentication" IsChecked="{Binding IsPasswordAuthentication}" />
                  <RadioButton Content="SSH key" GroupName="authentication" IsChecked="{Binding IsKeyAuthentication}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding IsPasswordAuthentication}">
                <TextBlock Text="SSH password" Classes="field-label" />
                <TextBox Text="{Binding Password}" PasswordChar="●" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding IsKeyAuthentication}">
                <TextBlock Text="SSH key" Classes="field-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Text="{Binding KeyPath}" />
                  <Button Grid.Column="1" Content="Browse" Click="ChooseKey" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding IsKeyAuthentication}">
                <TextBlock Text="Key passphrase" Classes="field-label" />
                <TextBox Text="{Binding KeyPassphrase}" PasswordChar="●" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Panel>

    <GridSplitter x:Name="ConnectionTaskSplitter" Grid.Row="2" Classes="section-splitter"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <TabControl x:Name="TaskTabs" Grid.Row="3" IsEnabled="{Binding InputsEnabled}">
      <TabItem Header="Deploy">
        <ScrollViewer>
          <StackPanel Margin="4,8" Spacing="10">
            <Border Classes="panel">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.ColumnSpan="2" Text="Deployment settings" Classes="section-title" />
                <TextBlock Grid.Row="1" Text="Project" Classes="field-label" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox x:Name="ProjectTextBox" Text="{Binding ProjectRoot}" />
                  <Button Grid.Column="1" Content="Browse" Click="ChooseProject" />
                </Grid>
                <TextBlock Grid.Row="2" Text="Remote dir" Classes="field-label" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RemoteDirectory}" />
                <TextBlock Grid.Row="3" Text="Sudo password" Classes="field-label" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SudoPassword}" PasswordChar="●"
                         PlaceholderText="Uses SSH password when empty" />
                <CheckBox Grid.Row="4" Grid.Column="1" Content="Build ARM64 image before deploy" IsChecked="{Binding BuildImage}" />
              </Grid>
            </Border>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="DeployButton" Classes="action primary" Content="Deploy" Command="{Binding DeployCommand}" />
              <Button x:Name="InstallPrerequisitesButton" Classes="action" Content="Install Prerequisites" Command="{Binding InstallPrerequisitesCommand}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Manage">
        <StackPanel Margin="4,8" Spacing="10">
          <TextBlock Classes="caption" Text="Run read-only checks or restart the installed service." />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button x:Name="TestSshButton" Classes="action" Content="Test SSH" Command="{Binding TestConnectionCommand}" />
            <Button x:Name="StatusButton" Classes="action" Content="Status" Command="{Binding StatusCommand}" />
            <Button x:Name="LogsButton" Classes="action" Content="Logs" Command="{Binding LogsCommand}" />
            <Button x:Name="RestartButton" Classes="action" Content="Restart" Command="{Binding RestartCommand}" />
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Wi-Fi">
        <ScrollViewer>
          <StackPanel Margin="4,8" Spacing="10">
            <Border Classes="panel">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.ColumnSpan="2" Text="Wi-Fi settings" Classes="section-title" />
                <TextBlock Grid.Row="1" Text="SSID" Classes="field-label" />
                <TextBox x:Name="WifiSsidTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding WifiSsid}" />
                <TextBlock Grid.Row="2" Text="Wi-Fi password" Classes="field-label" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WifiPassword}" PasswordChar="●" />
                <CheckBox Grid.Row="3" Grid.Column="1" Content="Connect immediately" IsChecked="{Binding WifiConnect}" />
              </Grid>
            </Border>
            <Button x:Name="ApplyWifiButton" Classes="action primary" HorizontalAlignment="Left"
                    Content="Apply Wi-Fi" Command="{Binding ApplyWifiCommand}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="About">
        <ScrollViewer>
          <StackPanel Margin="4,8" Spacing="10">
            <TextBlock Text="Raspberry Pi OMT Client Deployer" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" Classes="caption" />
            <TextBlock Text="{Binding CopyrightNotice}" TextWrapping="Wrap" />
            <TextBlock Text="Project license" Classes="section-title" Margin="0,8,0,0" />
            <TextBox Text="{Binding ProjectLicense}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="180" />
            <TextBlock Text="Third-party notices" Classes="section-title" Margin="0,8,0,0" />
            <TextBox Text="{Binding ThirdPartyNotices}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="240" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <GridSplitter x:Name="TaskActivitySplitter" Grid.Row="4" Classes="section-splitter"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <Border Grid.Row="5" Classes="panel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Border x:Name="ValidationInfoBar" Classes="infobar" Margin="0,0,0,2"
                IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Border Classes="chip">
            <TextBlock Text="{Binding Activity}" />
          </Border>
          <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       VerticalAlignment="Center" Margin="4,0"
                       AutomationProperties.Name="Action in progress" />
          <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Grid.Column="3" Content="Clear Log" Command="{Binding ClearLogCommand}" />
        </Grid>

        <Border Grid.Row="2" Classes="console">
          <ListBox x:Name="ActivityList" ItemsSource="{Binding ActivityLog}"
                   Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="Activity log">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogLine">
                <TextBlock Classes="log"
                           Classes.warning="{Binding IsWarning}"
                           Classes.error="{Binding IsError}"
                           Text="{Binding Message}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
