<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RpiOmt.Deployer.App.ViewModels"
        x:Class="RpiOmt.Deployer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Raspberry Pi OMT Client Deployer"
        Width="960" Height="700" MinWidth="360" MinHeight="360"
        Background="{DynamicResource AppSurfaceAltBrush}"
        Closing="OnClosing">
  <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <Panel Grid.Row="0" Container.Name="header" Container.Sizing="Width">
      <Panel.Styles>
        <Style Selector="StackPanel.header-title">
          <Setter Property="Grid.Column" Value="0" />
        </Style>
        <Style Selector="StackPanel.theme-settings">
          <Setter Property="Grid.Column" Value="1" />
        </Style>
        <ContainerQuery Name="header" Query="max-width:540">
          <Style Selector="StackPanel.header-title">
            <Setter Property="Grid.ColumnSpan" Value="2" />
          </Style>
          <Style Selector="StackPanel.theme-settings">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
          </Style>
        </ContainerQuery>
      </Panel.Styles>
      <Grid x:Name="HeaderGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Classes="header-title">
          <TextBlock Text="Raspberry Pi OMT Client Deployer" Classes="title" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding AppVersion, StringFormat='Version {0}'}" />
        </StackPanel>
        <StackPanel x:Name="ThemeSettings" Classes="theme-settings"
                    Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Theme" Classes="field-label" />
          <ComboBox x:Name="ThemeSelector" MinWidth="110"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding Theme}"
                    AutomationProperties.Name="Theme" />
        </StackPanel>
      </Grid>
    </Panel>

    <Border x:Name="ValidationInfoBar" Grid.Row="1" Classes="infobar"
            IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Top" />
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <TabControl x:Name="TaskTabs" Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="Connect">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8" Spacing="10">
            <TextBlock Classes="caption" Text="Choose the Raspberry Pi and the SSH credentials used by every remote action."
                       TextWrapping="Wrap" />
            <Panel Container.Name="connection" Container.Sizing="Width">
              <Panel.Styles>
                <Style Selector="StackPanel.connection-column-a">
                  <Setter Property="Grid.Row" Value="1" />
                  <Setter Property="Grid.Column" Value="0" />
                </Style>
                <Style Selector="StackPanel.connection-column-b">
                  <Setter Property="Grid.Row" Value="1" />
                  <Setter Property="Grid.Column" Value="1" />
                </Style>
                <ContainerQuery Name="connection" Query="max-width:720">
                  <Style Selector="StackPanel.connection-column-a">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                  </Style>
                  <Style Selector="StackPanel.connection-column-b">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                  </Style>
                </ContainerQuery>
              </Panel.Styles>
              <Border Classes="panel" IsEnabled="{Binding InputsEnabled}">
                <Grid x:Name="ConnectionGrid" RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="10">
                  <TextBlock Grid.ColumnSpan="2" Text="Connection" Classes="section-title" />

                  <StackPanel Classes="connection-column-a" Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Pi host" Classes="field-label" />
                      <TextBox x:Name="HostTextBox" Text="{Binding Host}"
                               PlaceholderText="pi.local or 192.168.1.10" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Username" Classes="field-label" />
                        <TextBox Text="{Binding Username}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" Width="96">
                        <TextBlock Text="SSH port" Classes="field-label" />
                        <TextBox MinWidth="0" Text="{Binding Port}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <StackPanel x:Name="ConnectionColumnB" Classes="connection-column-b" Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Authentication" Classes="field-label" />
                      <WrapPanel ItemSpacing="16" LineSpacing="4">
                        <RadioButton Content="Password" GroupName="authentication"
                                     IsChecked="{Binding IsPasswordAuthentication}" />
                        <RadioButton Content="SSH key" GroupName="authentication"
                                     IsChecked="{Binding IsKeyAuthentication}" />
                      </WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding IsPasswordAuthentication}">
                      <TextBlock Text="SSH password" Classes="field-label" />
                      <TextBox Text="{Binding Password}" PasswordChar="●" />
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding IsKeyAuthentication}">
                      <TextBlock Text="SSH key" Classes="field-label" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding KeyPath}" />
                        <Button Grid.Column="1" Content="Browse" Click="ChooseKey" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding IsKeyAuthentication}">
                      <TextBlock Text="Key passphrase" Classes="field-label" />
                      <TextBox Text="{Binding KeyPassphrase}" PasswordChar="●" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </Panel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Deploy">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8" Spacing="10" IsEnabled="{Binding InputsEnabled}">
            <TextBlock Classes="caption" Text="Prepare the release capsule and install it on the connected Raspberry Pi."
                       TextWrapping="Wrap" />
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Deployment settings" Classes="section-title" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Project" Classes="field-label" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="ProjectTextBox" Text="{Binding ProjectRoot}" />
                    <Button Grid.Column="1" Content="Browse" Click="ChooseProject" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Remote directory" Classes="field-label" />
                  <TextBox Text="{Binding RemoteDirectory}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Sudo password" Classes="field-label" />
                  <TextBox Text="{Binding SudoPassword}" PasswordChar="●"
                           PlaceholderText="Uses SSH password when empty" />
                </StackPanel>
                <CheckBox Content="Build ARM64 image before deploy" IsChecked="{Binding BuildImage}" />
              </StackPanel>
            </Border>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button x:Name="DeployButton" Classes="action primary" Content="Deploy"
                      Command="{Binding DeployCommand}" />
              <Button x:Name="InstallPrerequisitesButton" Classes="action" Content="Install Prerequisites"
                      Command="{Binding InstallPrerequisitesCommand}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Manage">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8" Spacing="10">
            <TextBlock Classes="caption" Text="Run read-only checks or restart the installed service."
                       TextWrapping="Wrap" />
            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Text="Remote management" Classes="section-title" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="TestSshButton" Classes="action" Content="Test SSH"
                          Command="{Binding TestConnectionCommand}" />
                  <Button x:Name="StatusButton" Classes="action" Content="Status"
                          Command="{Binding StatusCommand}" />
                  <Button x:Name="LogsButton" Classes="action" Content="Logs"
                          Command="{Binding LogsCommand}" />
                  <Button x:Name="RestartButton" Classes="action" Content="Restart"
                          Command="{Binding RestartCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Wi-Fi">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8" Spacing="10" IsEnabled="{Binding InputsEnabled}">
            <TextBlock Classes="caption" Text="Update NetworkManager on the connected Raspberry Pi."
                       TextWrapping="Wrap" />
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Wi-Fi settings" Classes="section-title" />
                <StackPanel Spacing="2">
                  <TextBlock Text="SSID" Classes="field-label" />
                  <TextBox x:Name="WifiSsidTextBox" Text="{Binding WifiSsid}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Wi-Fi password" Classes="field-label" />
                  <TextBox Text="{Binding WifiPassword}" PasswordChar="●" />
                </StackPanel>
                <CheckBox Content="Connect immediately" IsChecked="{Binding WifiConnect}" />
              </StackPanel>
            </Border>
            <Button x:Name="ApplyWifiButton" Classes="action primary" HorizontalAlignment="Left"
                    Content="Apply Wi-Fi" Command="{Binding ApplyWifiCommand}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Activity">
        <Grid Margin="4,8" RowDefinitions="Auto,*" RowSpacing="10">
          <Panel Container.Name="activity-toolbar" Container.Sizing="Width">
            <Panel.Styles>
              <Style Selector="WrapPanel.activity-buttons">
                <Setter Property="Grid.Column" Value="1" />
              </Style>
              <ContainerQuery Name="activity-toolbar" Query="max-width:520">
                <Style Selector="WrapPanel.activity-buttons">
                  <Setter Property="Grid.Row" Value="1" />
                  <Setter Property="Grid.Column" Value="0" />
                  <Setter Property="Grid.ColumnSpan" Value="2" />
                  <Setter Property="Margin" Value="0,8,0,0" />
                </Style>
              </ContainerQuery>
            </Panel.Styles>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Deployment activity" Classes="section-title" VerticalAlignment="Center" />
              <WrapPanel x:Name="ActivityButtons" Classes="activity-buttons" ItemSpacing="8" LineSpacing="8">
                <Button x:Name="CopyLogButton" Content="Copy Log" Click="CopyLog" />
                <Button x:Name="ExportLogButton" Content="Export Log" Click="ExportLog" />
                <Button x:Name="ClearLogButton" Content="Clear Log" Command="{Binding ClearLogCommand}" />
              </WrapPanel>
            </Grid>
          </Panel>

          <Border Grid.Row="1" Classes="console">
            <ListBox x:Name="ActivityList" ItemsSource="{Binding ActivityLog}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Activity log">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <SelectableTextBlock Classes="log"
                                       Classes.warning="{Binding IsWarning}"
                                       Classes.error="{Binding IsError}"
                                       Text="{Binding Message}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8" Spacing="10">
            <TextBlock Text="Raspberry Pi OMT Client Deployer" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" Classes="caption" />
            <TextBlock Text="{Binding CopyrightNotice}" TextWrapping="Wrap" />
            <TextBlock Text="Project license" Classes="section-title" Margin="0,8,0,0" />
            <TextBox Text="{Binding ProjectLicense}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="180" />
            <TextBlock Text="Third-party notices" Classes="section-title" Margin="0,8,0,0" />
            <TextBox Text="{Binding ThirdPartyNotices}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="240" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Classes="statusbar">
      <Panel Container.Name="operation-status" Container.Sizing="Width">
        <Panel.Styles>
          <Style Selector="WrapPanel.status-actions">
            <Setter Property="Grid.Column" Value="2" />
          </Style>
          <ContainerQuery Name="operation-status" Query="max-width:560">
            <Style Selector="WrapPanel.status-actions">
              <Setter Property="Grid.Row" Value="1" />
              <Setter Property="Grid.Column" Value="0" />
              <Setter Property="Grid.ColumnSpan" Value="3" />
              <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
          </ContainerQuery>
        </Panel.Styles>
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Border Classes="chip">
            <TextBlock Text="{Binding Activity}" />
          </Border>
          <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                       VerticalAlignment="Center" Margin="4,0"
                       AutomationProperties.Name="Action in progress" />
          <WrapPanel Classes="status-actions" ItemSpacing="8" LineSpacing="8">
            <Button x:Name="ViewActivityButton" Content="View Activity" Click="ShowActivity" />
            <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
          </WrapPanel>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</Window>
