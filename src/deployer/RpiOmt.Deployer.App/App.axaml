<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RpiOmt.Deployer.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RpiOmt.Deployer.App/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0B5CAB" RegionColor="#EEF2F8" />
        <ColorPaletteResources x:Key="Dark" Accent="#7CB8FF" RegionColor="#0A1119" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RpiOmt.Deployer.App/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
