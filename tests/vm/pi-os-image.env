# Official Raspberry Pi OS Full (64-bit), pinned for reproducible VM tests.
# Update the URL and checksum together from Raspberry Pi's OS download page.
PI_OS_IMAGE_NAME=2026-06-18-raspios-trixie-arm64-full.img
PI_OS_IMAGE_URL=https://downloads.raspberrypi.com/raspios_full_arm64/images/raspios_full_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-full.img.xz
PI_OS_IMAGE_SHA256=2ca7ec6ac0e43595774ebf1061334a00f9dc0d1ea879b895a174a52ea8e32ec3

# raspi4b was introduced in QEMU 9, but its emulated USB path is not reliable
# enough for unattended SSH tests. raspi3b boots the same ARM64 Pi OS image and
# provides the systemd/userland boundary this suite needs.
PI_OS_QEMU_MACHINE=raspi3b
PI_OS_QEMU_MIN_MAJOR=9
PI_OS_VM_DISK_BYTES=17179869184
PI_OS_VM_SSH_PORT=5022
PI_OS_VM_WEB_PORT=5500
