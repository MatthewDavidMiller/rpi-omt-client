#!/sbin/openrc-run

description="Filtered Avahi system bus proxy for OMT Client"
supervisor=supervise-daemon
command=/usr/bin/xdg-dbus-proxy
command_args="unix:path=/run/dbus/system_bus_socket ${OMT_AVAHI_PROXY_SOCKET} --filter --talk=org.freedesktop.Avahi"
# The proxy must run under the same UID the container's receiver connects with.
# xdg-dbus-proxy serves its socket through GDBus, whose default authorization
# accepts an authenticated peer only when the peer's credentials name the
# server's own user. Running as nobody left every client connection from the
# omt user dropped during the D-Bus handshake, so mDNS discovery returned an
# empty set immediately instead of browsing: a group grant cannot substitute
# for the UID match.
command_user="${OMT_UID}:${OMT_GID}"
umask=0117
respawn_delay=1
respawn_max=0

depend() {
    need dbus avahi-daemon
    after networking
}

start_pre() {
    rm -f -- "${OMT_AVAHI_PROXY_SOCKET}"
}

start_post() {
    local attempt
    for attempt in $(seq 1 50); do
        # POSIX test: openrc-run executes this under /bin/sh, and busybox ash
        # accepts the bash double-bracket form only because Alpine happens to
        # build it with the bash compatibility option enabled.
        if [ -S "${OMT_AVAHI_PROXY_SOCKET}" ]; then
            chown "${OMT_UID}:${OMT_GID}" "${OMT_AVAHI_PROXY_SOCKET}"
            chmod 0660 "${OMT_AVAHI_PROXY_SOCKET}"
            return 0
        fi
        sleep 0.1
    done
    eerror "Filtered Avahi proxy did not create its socket"
    # respawn_max=0 means supervise-daemon retries forever, so a proxy that
    # cannot bind is still supervised after this failure returns. Left running
    # it turns every subsequent start into "xdg-dbus-proxy is already running",
    # which reports a collision with our own orphan instead of the bind error
    # that actually needs fixing.
    supervise-daemon "${RC_SVCNAME}" --stop --quiet >/dev/null 2>&1 || true
    return 1
}

stop_post() {
    rm -f -- "${OMT_AVAHI_PROXY_SOCKET}"
}
