#!/sbin/openrc-run

description="OMT Client Docker appliance"

depend() {
    need docker
    use dbus avahi-daemon
    after networking omt-client-avahi-proxy
}

start_pre() {
    if [ ! -d "${OMT_INSTALL_DIR}" ] || [ -L "${OMT_INSTALL_DIR}" ]; then
        eerror "OMT Client install directory is missing or unsafe"
        return 1
    fi
    "${OMT_RECOVERY_HELPER}" recover "${OMT_INSTALL_DIR}" "${OMT_RECOVERY_MANIFEST}"
    # Alpine's supervised Docker service can be marked started while dockerd
    # is still initializing containerd and has not created its API socket.
    # `need docker` orders the jobs but does not guarantee API readiness. On a
    # clean Pi 5 boot that race made this service fail once and remain stopped
    # until an operator restarted it. Keep the boot bounded while waiting for
    # the dependency we actually consume.
    local docker_wait=0
    until docker info >/dev/null 2>&1; do
        docker_wait=$((docker_wait + 1))
        if [ "${docker_wait}" -ge 30 ]; then
            eerror "Docker did not become ready within 30 seconds"
            return 1
        fi
        sleep 1
    done
    find /dev/dri -maxdepth 1 -type c -name 'card*' -print -quit 2>/dev/null | grep -q . || {
        eerror "OMT Client requires a primary DRM card under /dev/dri"
        return 1
    }
    find /dev/snd -maxdepth 1 -type c -name 'pcmC*D*p' -print -quit 2>/dev/null | grep -q . || {
        eerror "OMT Client requires an ALSA playback PCM under /dev/snd"
        return 1
    }
    # Without the memory controller, compose's mem_limit is accepted and then
    # ignored, and the appliance runs uncapped on a board sized around a
    # 256 MiB container. The Raspberry Pi firmware puts cgroup_disable=memory
    # on the command line ahead of the installer's cgroup_enable=memory and
    # the later token only wins by the kernel's __setup ordering, so this is
    # checked rather than assumed. Under cgroup v2 the controller is absent
    # from /proc/cgroups even when present, so read the unified list first.
    local memory_controller=1
    if [ -r /sys/fs/cgroup/cgroup.controllers ]; then
        grep -qw memory /sys/fs/cgroup/cgroup.controllers
        memory_controller=$?
    elif [ -r /proc/cgroups ]; then
        awk '$1 == "memory" && $4 == "1" { found = 1 } END { exit !found }' /proc/cgroups
        memory_controller=$?
    fi
    if [ "${memory_controller}" -ne 0 ]; then
        eerror "The kernel memory controller is unavailable, so the container"
        eerror "memory cap cannot be enforced. Ensure cgroup_enable=memory is"
        eerror "on the boot command line and reboot; re-run the installer if"
        eerror "it is missing from cmdline.txt."
        return 1
    fi
}

start() {
    ebegin "Starting OMT Client container"
    cd "${OMT_INSTALL_DIR}"
    docker compose --env-file "${OMT_COMPOSE_ENV_FILE}" \
        -f "${OMT_COMPOSE_FILE}" up -d
    eend $?
}

stop() {
    ebegin "Stopping OMT Client container"
    cd "${OMT_INSTALL_DIR}"
    docker compose --env-file "${OMT_COMPOSE_ENV_FILE}" \
        -f "${OMT_COMPOSE_FILE}" down
    eend $?
}
